# Solo Edge Runtime. Nunca VITE_*. No versionar valores reales.
# SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY son del runtime
# hospedado; comprobar su disponibilidad sin imprimirlos. No sobrescribirlos.
# En local copiar a .env.local ignorado. En Cloud usar Secrets del proyecto.
FICHA_ALLOWED_ORIGINS=http://127.0.0.1:5173
EXPEDIENTE_ALLOWED_ORIGINS=http://127.0.0.1:5173
H7_OS_ALLOWED_ORIGINS=http://127.0.0.1:5173
RUC_ALLOWED_ORIGINS=http://127.0.0.1:5173
DNI_ALLOWED_ORIGINS=http://127.0.0.1:5173
# En hospedado sustituir TODOS los orígenes por HTTPS exactos separados por coma.
# Sin rutas, comodines, localhost ni previews no aprobadas.
# APIsPERU permanece deshabilitado en hospedado. NO cargar el token en Cloud.
APISPERU_TOKEN=
APISPERU_PRODUCTION_AUTHORIZED=false
# OpenRUC no utiliza APISPERU_TOKEN; consultar docs/deployment/hosted.md.
