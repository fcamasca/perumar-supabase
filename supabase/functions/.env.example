# Solo Edge Runtime. Copiar a supabase/functions/.env.local (ignorado por Git).
# Nunca VITE_*; no introducir el token en comandos, código, capturas o logs.
APISPERU_TOKEN=
# Producción queda bloqueada hasta confirmar cuenta/plan, términos y uso autorizado.
APISPERU_PRODUCTION_AUTHORIZED=false
# En hospedado configurar los orígenes HTTPS autorizados, separados por coma.
DNI_ALLOWED_ORIGINS=http://127.0.0.1:5173
