{
  "name": "perumar-supabase",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": "24.19.0",
    "npm": "10.9.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:edge": "npx --yes deno@2.1.4 check --config=supabase/functions/ficha-matricula/deno.json --node-modules-dir=none --frozen supabase/functions/ficha-matricula/index.ts",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "supabase:start": "node scripts/local-supabase.mjs start",
    "supabase:status": "node scripts/local-supabase.mjs status",
    "supabase:stop": "node scripts/local-supabase.mjs stop",
    "supabase:reset": "node scripts/local-supabase.mjs reset",
    "supabase:env": "node scripts/check-local.mjs env",
    "test:local": "node scripts/check-local.mjs",
    "test:build-safety": "node scripts/check-build-safety.mjs",
    "fixtures:human": "node scripts/h2-fixtures.mjs human",
    "test:security": "node scripts/test-security.mjs",
    "test:expiry": "node scripts/test-expiry.mjs",
    "test:enrollment": "node scripts/test-enrollment.mjs",
    "test:academic": "node scripts/test-academic.mjs",
    "test:payments": "node scripts/test-payments.mjs",
    "test:payments:rollback": "node scripts/test-payments-rollback.mjs",
    "test:payments:isolated": "node scripts/test-payments-isolated.mjs",
    "test:pdf:rollback": "node scripts/test-pdf-rollback.mjs",
    "test:pdf": "node scripts/test-pdf.mjs",
    "pdf:cleanup": "node scripts/cleanup-pdf.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "pdf-lib": "1.17.1",
    "supabase": "2.121.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
