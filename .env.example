# Públicas: todo VITE_* se incluye en el navegador. Nunca secret/service_role/SQL/PAT.
# Local: modo predeterminado seguro si se omite; los scripts locales lo conservan.
VITE_DEPLOYMENT_ENV=local
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=REEMPLAZAR_POR_CLAVE_PUBLICA_LOCAL
# No definir PROJECT_REF en local.
# Hospedado: configurar estas cuatro variables en Pages, no copiar .env.local.
# VITE_DEPLOYMENT_ENV=hosted
# VITE_SUPABASE_PROJECT_REF=REEMPLAZAR_POR_REF_REAL_20_CARACTERES
# VITE_SUPABASE_URL=https://REF_REAL.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=REEMPLAZAR_POR_CLAVE_PUBLICABLE_DEL_PROYECTO
